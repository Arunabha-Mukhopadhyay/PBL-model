import pandas as pd
import numpy as np
import joblib
import matplotlib.pyplot as plt
from sklearn.ensemble import RandomForestRegressor
from sklearn.model_selection import train_test_split, KFold, cross_val_score
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from scipy.stats import pearsonr

# Function to calculate Concordance Correlation Coefficient (CCC)
def concordance_correlation_coefficient(y_true, y_pred):
    """
    Calculates Lin's concordance correlation coefficient.
    """
    # Calculate Pearson correlation
    cor = pearsonr(y_true, y_pred)[0]

    # Calculate means
    mean_true = np.mean(y_true)
    mean_pred = np.mean(y_pred)

    # Calculate variances
    var_true = np.var(y_true)
    var_pred = np.var(y_pred)

    # Formula for CCC
    numerator = 2 * cor * np.std(y_true) * np.std(y_pred)
    denominator = var_true + var_pred + (mean_true - mean_pred)**2

    return numerator / denominator

# Function to evaluate and visualize model performance
def evaluate_random_forest(model, X_train, X_test, y_train, y_test, feature_names):
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)

    # Calculate metrics
    rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    mae = mean_absolute_error(y_test, y_pred)
    r2 = r2_score(y_test, y_pred)
    ccc = concordance_correlation_coefficient(y_test, y_pred)

    # Cross-validation
    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    cv_scores = cross_val_score(model, X_scaled, y, cv=kf, scoring="r2")
    cv_r2_mean = np.mean(cv_scores)

    # Save model
    joblib.dump(model, "random_forest_regressor_model.pkl")

    # Visualization
    plt.figure(figsize=(12, 10))

    # Plot 1: Predicted vs Actual
    plt.subplot(2, 1, 1)
    plt.scatter(y_test, y_pred, alpha=0.6, color="green", label="Predicted vs Actual")
    plt.plot([min(y), max(y)], [min(y), max(y)], color="red", linestyle="--", label="Ideal")
    plt.xlabel("Actual Star Rating")
    plt.ylabel("Predicted Star Rating")
    plt.title("Random Forest Regressor: Star Rating Prediction")
    plt.legend()
    plt.grid(True)

    # Plot 2: Residuals
    plt.subplot(2, 1, 2)
    residuals = y_test - y_pred
    plt.scatter(y_pred, residuals, alpha=0.6, color="blue")
    plt.axhline(y=0, color="red", linestyle="--")
    plt.xlabel("Predicted Values")
    plt.ylabel("Residuals")
    plt.title("Residual Plot (Actual - Predicted)")
    plt.grid(True)

    plt.tight_layout()
    plt.savefig("random_forest_prediction_quality.png")
    plt.close()

    # Feature importance
    feature_importance = {}
    for i, feature in enumerate(feature_names):
        feature_importance[feature] = model.feature_importances_[i]

    # Feature importance visualization
    plt.figure(figsize=(10, 6))
    features = list(feature_importance.keys())
    importances = list(feature_importance.values())
    indices = np.argsort(importances)

    plt.barh(range(len(indices)), [importances[i] for i in indices], color='skyblue')
    plt.yticks(range(len(indices)), [features[i] for i in indices])
    plt.xlabel('Relative Importance')
    plt.title('Random Forest Feature Importance')
    plt.tight_layout()
    plt.savefig('random_forest_feature_importance.png')
    plt.close()

    return {
        'model': model,
        'rmse': rmse,
        'mae': mae,
        'r2': r2,
        'ccc': ccc,
        'cv_r2_mean': cv_r2_mean,
        'feature_importance': feature_importance
    }

# Load and preprocess dataset
df = pd.read_csv("updated_js_questions.csv")

# Handle NaN values more carefully
numeric_cols = df.select_dtypes(include=[np.number]).columns
for col in numeric_cols:
    df[col].fillna(df[col].median(), inplace=True)

# Make sure we have the star_rating column
if 'star_rating' in df.columns:
    df.dropna(subset=["star_rating"], inplace=True)
else:
    print("Error: 'star_rating' column not found")
    exit()

# Label Encoding for categorical columns
if 'difficulty' in df.columns:
    difficulty_encoder = LabelEncoder()
    df["difficulty_encoded"] = difficulty_encoder.fit_transform(df["difficulty"].astype(str))
    joblib.dump(difficulty_encoder, "difficulty_encoder.pkl")
else:
    print("Warning: 'difficulty' column not found")
    df["difficulty_encoded"] = 0  # Default value

if 'confidence_level' in df.columns:
    confidence_encoder = LabelEncoder()
    df["confidence_encoded"] = confidence_encoder.fit_transform(df["confidence_level"].astype(str))
    joblib.dump(confidence_encoder, "confidence_encoder.pkl")
else:
    print("Warning: 'confidence_level' column not found")
    df["confidence_encoded"] = 0  # Default value

# Features and Target - Check if all features exist
available_features = []
for feature in ["weightage", "time_alloted", "time_taken", "difficulty_encoded",
                "subtopic_multiplier", "time_multiplier", "confidence_encoded", "confidence_multiplier"]:
    if feature in df.columns:
        available_features.append(feature)
    else:
        print(f"Warning: Feature '{feature}' not found in dataset")

if not available_features:
    print("Error: No valid features found")
    exit()

target = "star_rating"
X = df[available_features]
y = df[target]

# Standard Scaling
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
joblib.dump(scaler, "scaler.pkl")

# Train/Test Split
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

# Create and configure Random Forest Regressor
random_forest = RandomForestRegressor(
    n_estimators=100,
    max_depth=10,
    min_samples_split=5,
    min_samples_leaf=2,
    max_features="sqrt",
    random_state=42
)

# Train and evaluate the model
print("\n🔍 Training Random Forest Regressor...")
results = evaluate_random_forest(random_forest, X_train, X_test, y_train, y_test, available_features)

# Topic-Level Analysis
if 'topic' in df.columns:
    # Convert 'correct' column to a binary format if it exists
    if 'correct' in df.columns:
        # Extract the correct answer from the 'correct' column
        df['is_correct'] = 1  # Placeholder assuming all are correct

        # Calculate topic accuracy - this is just a placeholder logic
        topic_stats = df.groupby("topic")["is_correct"].mean()

        strong_topics = topic_stats[topic_stats >= 0.7].index.tolist()
        weak_topics = topic_stats[topic_stats < 0.7].index.tolist()
    else:
        print("Warning: 'correct' column not found for topic analysis")
        strong_topics = []
        weak_topics = []
else:
    print("Warning: 'topic' column not found")
    strong_topics = []
    weak_topics = []

# Individual feature performance analysis
print("\n🔍 Evaluating individual feature performance...")
feature_performance = {}

for feature in available_features:
    # Use only one feature at a time
    X_single = df[[feature]]
    X_single_scaled = scaler.fit_transform(X_single)

    # Train-test split
    X_train_single, X_test_single, y_train_single, y_test_single = train_test_split(
        X_single_scaled, y, test_size=0.2, random_state=42
    )

    # Use Random Forest to evaluate the feature
    model = RandomForestRegressor(n_estimators=50, max_depth=5, random_state=42)
    model.fit(X_train_single, y_train_single)
    y_pred = model.predict(X_test_single)

    # Calculate metrics
    r2 = r2_score(y_test_single, y_pred)
    ccc = concordance_correlation_coefficient(y_test_single, y_pred)
    rmse = np.sqrt(mean_squared_error(y_test_single, y_pred))
    mae = mean_absolute_error(y_test_single, y_pred)

    feature_performance[feature] = {
        'R²': r2,
        'CCC': ccc,
        'RMSE': rmse,
        'MAE': mae
    }

# Create DataFrame for individual feature performance
individual_feature_df = pd.DataFrame(feature_performance).T
individual_feature_df.index.name = 'Feature'
individual_feature_df = individual_feature_df.reset_index()

# Sort by R² score
individual_feature_df = individual_feature_df.sort_values('R²', ascending=False)

print("\n🔬 INDIVIDUAL FEATURE PERFORMANCE:")
print(individual_feature_df.round(4))

# Print comprehensive analysis of the model
print("\n🏆 RANDOM FOREST REGRESSOR MODEL PERFORMANCE:")
print(f"CCC: {results['ccc']:.4f}")
print(f"R² Score: {results['r2']:.4f}")
print(f"RMSE: {results['rmse']:.4f}")
print(f"MAE: {results['mae']:.4f}")
print(f"Cross-validation R² Mean: {results['cv_r2_mean']:.4f}")

# Create enhanced feature importance comparison
print("\n📊 ENHANCED FEATURE IMPORTANCE ANALYSIS:")
enhanced_feature_importance = {}

# Get feature importance from the model
model_importance = results['feature_importance']

# For each feature, compare its individual performance with its importance in the combined model
for feature in available_features:
    individual_r2 = individual_feature_df.loc[individual_feature_df['Feature'] == feature, 'R²'].values[0]
    individual_ccc = individual_feature_df.loc[individual_feature_df['Feature'] == feature, 'CCC'].values[0]

    enhanced_feature_importance[feature] = {
        'Model Importance': model_importance[feature],
        'Individual R²': individual_r2,
        'Individual CCC': individual_ccc,
        'Performance Ratio': model_importance[feature] / max(abs(individual_r2), 0.001)  # To avoid division by zero
    }

# Convert to DataFrame for better display
enhanced_importance_df = pd.DataFrame(enhanced_feature_importance).T
enhanced_importance_df.index.name = 'Feature'
enhanced_importance_df = enhanced_importance_df.reset_index()
enhanced_importance_df = enhanced_importance_df.sort_values('Model Importance', ascending=False)

print(enhanced_importance_df.round(4))

# Print detailed feature importance with comparison
print("\n📊 DETAILED FEATURE IMPORTANCE:")
sorted_importance = sorted(model_importance.items(), key=lambda x: x[1], reverse=True)
for feature, importance in sorted_importance:
    individual_r2 = individual_feature_df.loc[individual_feature_df['Feature'] == feature, 'R²'].values[0]
    individual_ccc = individual_feature_df.loc[individual_feature_df['Feature'] == feature, 'CCC'].values[0]

    print(f"{feature}: {importance:.4f} (In combined model) vs {individual_r2:.4f} (Individual R²) / {individual_ccc:.4f} (Individual CCC)")

print("\n📘 TOPIC FEEDBACK:")
print(f"Strong Topics: {', '.join(strong_topics) if strong_topics else 'None'}")
print(f"Weak Topics: {', '.join(weak_topics) if weak_topics else 'None'}")

# Create prediction function for future use
def predict_star_rating(feature_values):
    """
    Predicts star rating using the trained Random Forest model.

    Parameters:
    - feature_values: Dictionary with feature names as keys and values to predict

    Returns:
    - Predicted star rating
    """
    # Load the model and scaler
    loaded_model = joblib.load("random_forest_regressor_model.pkl")
    loaded_scaler = joblib.load("scaler.pkl")

    # Prepare input data
    input_data = []
    for feature in available_features:
        if feature in feature_values:
            input_data.append(feature_values[feature])
        else:
            # Use a default value if the feature is not provided
            input_data.append(0)

    # Convert to numpy array and reshape
    input_array = np.array(input_data).reshape(1, -1)

    # Scale the input
    scaled_input = loaded_scaler.transform(input_array)

    # Make prediction
    prediction = loaded_model.predict(scaled_input)[0]

    return prediction

print("\n✅ Random Forest model training and evaluation complete!")
print("Use the predict_star_rating() function to make predictions with new data.")
