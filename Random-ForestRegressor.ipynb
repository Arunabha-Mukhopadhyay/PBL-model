from scipy.stats import pearsonr

# Function to calculate Concordance Correlation Coefficient (CCC)
def concordance_correlation_coefficient(y_true, y_pred):
    """
    Calculates Lin's concordance correlation coefficient.
    """
    # Calculate Pearson correlation
    cor = pearsonr(y_true, y_pred)[0]

    # Calculate means
    mean_true = np.mean(y_true)
    mean_pred = np.mean(y_pred)

    # Calculate variances
    var_true = np.var(y_true)
    var_pred = np.var(y_pred)

    # Formula for CCC
    numerator = 2 * cor * np.std(y_true) * np.std(y_pred)
    denominator = var_true + var_pred + (mean_true - mean_pred)**2

    return numerator / denominator

# Function to train and save the Random Forest model
def train_and_save_model(df, available_features):
    """
    Train a Random Forest model and save it for future use
    """
    target = "star_rating"
    X = df[available_features]
    y = df[target]

    # Standard Scaling
    print("Scaling features...")
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    joblib.dump(scaler, "scaler.pkl")

    # Train/Test Split
    X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

    # Create and configure Random Forest Regressor
    print("Training Random Forest model...")
    random_forest = RandomForestRegressor(
        n_estimators=100,
        max_depth=10,
        min_samples_split=5,
        min_samples_leaf=2,
        max_features="sqrt",
        random_state=42
    )

    # Train the model
    random_forest.fit(X_train, y_train)
    
    # Save the model
    joblib.dump(random_forest, "random_forest_regressor_model.pkl")
    
    print("Model trained and saved successfully!")
    return random_forest, scaler

# Function to generate random questions from dataset
def generate_random_questions(df, num_questions=None):
    """
    Generate a random set of questions from the dataset
    
    Parameters:
    - df: DataFrame containing question data
    - num_questions: Number of questions to generate (default: random between 20-25)
    
    Returns:
    - DataFrame with selected questions
    """
    if num_questions is None:
        num_questions = random.randint(20, 25)  # Random number between 20-25
    
    # Ensure we don't try to get more questions than available
    num_questions = min(num_questions, len(df))
    
    # Randomly select questions
    random_indices = random.sample(range(len(df)), num_questions)
    selected_questions = df.iloc[random_indices].copy()
    
    # Reset index for the selected questions
    selected_questions.reset_index(drop=True, inplace=True)
    
    print(f"\n GENERATED {num_questions} RANDOM QUESTIONS")
    return selected_questions

# Function to present questions to user and record responses
def present_questions_to_user(questions_df):
    """
    Present questions to user, record their answers and time taken
    
    Parameters:
    - questions_df: DataFrame containing questions to present
    
    Returns:
    - DataFrame with original questions and user response data
    """
    results_df = questions_df.copy()
    results_df['user_time_taken'] = 0.0  # Initialize time taken column
    results_df['user_answer'] = ""  # Initialize user answer column
    results_df['is_correct'] = False  # Initialize correctness column
    
    print("\n ANSWER THE FOLLOWING QUESTIONS:")
    total_time = 0
    
    for idx, row in questions_df.iterrows():
        # Display question information
        print(f"\n[Question {idx+1}/{len(questions_df)}]")
        print(f"Difficulty: {row['difficulty'] if 'difficulty' in row else 'Not specified'}")
        
        # Extract and display the full question text
        question_text = None
        
        # Check for different possible column names that might contain question text
        possible_text_columns = ['question_text', 'question', 'content', 'text']
        for col in possible_text_columns:
            if col in row and not pd.isna(row[col]):
                question_text = row[col]
                break
        
        # If no question text column found, try to use other information
        if question_text is None:
            if 'title' in row and not pd.isna(row['title']):
                question_text = row['title']
            elif 'question_id' in row:
                question_text = f"Question ID: {row['question_id']}\n(Question text not available)"
            else:
                question_text = f"Question #{idx+1}\n(Question text not available)"
        
        # Display the question
        print(f"\n{question_text}")
        
        # Display options if available
        if 'options' in row and not pd.isna(row['options']):
            print(f"\nOptions: {row['options']}")
        elif 'choices' in row and not pd.isna(row['choices']):
            print(f"\nOptions: {row['choices']}")
        
        # Time the user's answer
        start_time = time.time()
        user_answer = input("\nYour answer (or press Enter to skip): ")
        end_time = time.time()
        
        # Calculate time taken
        time_taken = end_time - start_time
        total_time += time_taken
        
        # Store user response data
        results_df.at[idx, 'user_time_taken'] = time_taken
        results_df.at[idx, 'user_answer'] = user_answer
        
        # Check correctness if answer is available
        # UPDATED: Added check for 'correct' column which exists in your dataset
        if 'correct_answer' in row and not pd.isna(row['correct_answer']) and user_answer:
            is_correct = user_answer.strip().lower() == str(row['correct_answer']).strip().lower()
            results_df.at[idx, 'is_correct'] = is_correct
            print(f"{'✓ Correct!' if is_correct else '✗ Incorrect'}")
        elif 'answer' in row and not pd.isna(row['answer']) and user_answer:
            is_correct = user_answer.strip().lower() == str(row['answer']).strip().lower()
            results_df.at[idx, 'is_correct'] = is_correct
            print(f"{'✓ Correct!' if is_correct else '✗ Incorrect'}")
        elif 'correct' in row and not pd.isna(row['correct']) and user_answer:
            is_correct = user_answer.strip().lower() == str(row['correct']).strip().lower()
            results_df.at[idx, 'is_correct'] = is_correct
            print(f"{'✓ Correct!' if is_correct else '✗ Incorrect'}")
        
        print(f"Time taken: {time_taken:.2f} seconds")
        
    print(f"\nTotal time taken: {total_time:.2f} seconds ({total_time/60:.2f} minutes)")
    print(f"Average time per question: {total_time/len(questions_df):.2f} seconds")
    
    return results_df

# Function to calculate scores and star ratings
def calculate_scores_and_ratings(results_df, model, scaler, feature_columns):
    """
    Calculate scores and star ratings based on user responses and question parameters
    
    Parameters:
    - results_df: DataFrame with questions and user responses
    - model: Trained prediction model
    - scaler: Fitted scaler
    - feature_columns: List of feature columns used by the model
    
    Returns:
    - DataFrame with questions, responses, and calculated ratings
    """
    # Make a copy to avoid modifying the original
    analysis_df = results_df.copy()
    
    # Calculate raw score for each question (based on weightage if available)
    if 'weightage' in analysis_df.columns and 'is_correct' in analysis_df.columns:
        analysis_df['raw_score'] = analysis_df.apply(
            lambda row: row['weightage'] if row['is_correct'] else 0,
            axis=1
        )
    elif 'is_correct' in analysis_df.columns:
        # Default weightage of 1 if not specified
        analysis_df['raw_score'] = analysis_df['is_correct'].astype(int)
    else:
        # If no way to determine correctness, set a placeholder score
        analysis_df['raw_score'] = 1
    
    # Apply time factor (if question has time_alloted)
    if 'time_alloted' in analysis_df.columns and 'user_time_taken' in analysis_df.columns:
        analysis_df['time_factor'] = analysis_df.apply(
            lambda row: min(row['time_alloted'] / max(row['user_time_taken'], 1), 2),  # Cap at 2x bonus
            axis=1
        )
        # Apply time factor to raw score
        analysis_df['adjusted_score'] = analysis_df['raw_score'] * analysis_df['time_factor']
    else:
        analysis_df['adjusted_score'] = analysis_df['raw_score']
    
    # Apply difficulty multiplier if available
    if 'difficulty_multiplier' in analysis_df.columns:
        analysis_df['final_score'] = analysis_df['adjusted_score'] * analysis_df['difficulty_multiplier']
    else:
        # Create a basic difficulty multiplier based on encoded difficulty if available
        if 'difficulty_encoded' in analysis_df.columns:
            max_difficulty = analysis_df['difficulty_encoded'].max()
            if max_difficulty > 0:  # Avoid division by zero
                analysis_df['difficulty_multiplier'] = 1 + (analysis_df['difficulty_encoded'] / max_difficulty)
                analysis_df['final_score'] = analysis_df['adjusted_score'] * analysis_df['difficulty_multiplier']
            else:
                analysis_df['final_score'] = analysis_df['adjusted_score']
        else:
            analysis_df['final_score'] = analysis_df['adjusted_score']
    
    # Calculate total score
    total_possible_score = analysis_df['weightage'].sum() if 'weightage' in analysis_df.columns else len(analysis_df)
    total_achieved_score = analysis_df['final_score'].sum()
    score_percentage = (total_achieved_score / total_possible_score) * 100 if total_possible_score > 0 else 0
    
    # Calculate star rating using the model
    # For each question, predict star rating based on performance
    analysis_df['star_rating'] = analysis_df.apply(
        lambda row: calculate_star_rating(row, model, scaler, feature_columns),
        axis=1
    )
    
    # Calculate average star rating
    avg_star_rating = analysis_df['star_rating'].mean()
    
    # Print performance summary
    print("\n PERFORMANCE SUMMARY:")
    print(f"Total Score: {total_achieved_score:.2f}/{total_possible_score:.2f} ({score_percentage:.2f}%)")
    print(f"Star Rating: {avg_star_rating:.2f}/5.0")
    
    # Print performance by difficulty (if available)
    if 'difficulty' in analysis_df.columns:
        print("\nPerformance by Difficulty:")
        difficulty_performance = analysis_df.groupby('difficulty').agg({
            'is_correct': 'mean',
            'user_time_taken': 'mean',
            'star_rating': 'mean'
        }).reset_index()
        
        for _, row in difficulty_performance.iterrows():
            correct_pct = row['is_correct'] * 100 if pd.notna(row['is_correct']) else 0
            print(f"  {row['difficulty']}: {correct_pct:.1f}% correct, {row['user_time_taken']:.2f}s avg time, {row['star_rating']:.2f} stars")
    
    # Visualize results
    plt.figure(figsize=(12, 10))
    
    # Plot star ratings
    plt.subplot(2, 1, 1)
    plt.bar(range(len(analysis_df)), analysis_df['star_rating'], color='skyblue')
    plt.axhline(y=avg_star_rating, color='red', linestyle='--', label=f'Avg: {avg_star_rating:.2f}')
    plt.xlabel('Question Index')
    plt.ylabel('Star Rating')
    plt.title('Star Rating for Each Question')
    plt.legend()
    plt.grid(True, alpha=0.3)
    
    # Plot time taken
    plt.subplot(2, 1, 2)
    plt.bar(range(len(analysis_df)), analysis_df['user_time_taken'], color='lightgreen')
    avg_time = analysis_df['user_time_taken'].mean()
    plt.axhline(y=avg_time, color='red', linestyle='--', label=f'Avg: {avg_time:.2f}s')
    plt.xlabel('Question Index')
    plt.ylabel('Time Taken (seconds)')
    plt.title('Time Taken for Each Question')
    plt.legend()
    plt.grid(True, alpha=0.3)
    
    plt.tight_layout()
    plt.savefig('question_performance.png')
    plt.close()
    
    # Save results to CSV
    analysis_df.to_csv("question_results.csv", index=False)
    print("\n Results saved to 'question_results.csv'")
    
    return analysis_df, avg_star_rating

# Function to calculate star rating for a single question
def calculate_star_rating(question_row, model, scaler, feature_columns):
    """
    Calculate star rating for a question based on user performance and question parameters
    
    Parameters:
    - question_row: Series containing question data and user performance
    - model: Trained prediction model
    - scaler: Fitted scaler for feature normalization
    - feature_columns: List of feature column names used by the model
    
    Returns:
    - Predicted star rating
    """
    # Extract features
    features = []
    for feature in feature_columns:
        if feature in question_row:
            # If time_taken is a feature, use the user's actual time instead
            if feature == 'time_taken' and 'user_time_taken' in question_row:
                features.append(question_row['user_time_taken'])
            else:
                features.append(question_row[feature])
        else:
            # Use a default value if the feature is not available
            features.append(0)
    
    # Convert to numpy array and reshape for prediction
    input_array = np.array(features).reshape(1, -1)
    
    # Scale the input
    scaled_input = scaler.transform(input_array)
    
    # Make prediction
    prediction = model.predict(scaled_input)[0]
    
    return prediction

# Function to display the dataset structure
def display_dataset_structure(df):
    """
    Display the structure of the dataset to identify question text columns
    """
    print("\n DATASET STRUCTURE:")
    print(f"Columns: {df.columns.tolist()}")
    print("\nSample data (first row):")
    for col in df.columns:
        if col in df.iloc[0]:
            value = df.iloc[0][col]
            if isinstance(value, str) and len(value) > 50:
                print(f"{col}: {value[:50]}...")
            else:
                print(f"{col}: {value}")

# Main function to run the interactive question session
def run_interactive_session():
    """
    Run the complete interactive question session
    """
    print(" JS QUESTIONS ASSESSMENT")
    print("=======================")
    
    # Load dataset
    print("Loading dataset...")
    try:
        df = pd.read_csv("updated_js_questions.csv")
        print(f"Dataset loaded successfully with {len(df)} questions")
    except FileNotFoundError:
        print("Error: Could not find the dataset file 'updated_js_questions.csv'")
        return
    
    # Display dataset structure to identify question text columns
    display_dataset_structure(df)
    
    # Handle NaN values carefully
    numeric_cols = df.select_dtypes(include=[np.number]).columns
    for col in numeric_cols:
        df[col].fillna(df[col].median(), inplace=True)
    
    # Check for star_rating column
    if 'star_rating' not in df.columns:
        print("Error: 'star_rating' column not found in dataset")
        return
    df.dropna(subset=["star_rating"], inplace=True)
    
    # Label encoding for categorical columns
    encoded_features = {}
    
    if 'difficulty' in df.columns:
        difficulty_encoder = LabelEncoder()
        df["difficulty_encoded"] = difficulty_encoder.fit_transform(df["difficulty"].astype(str))
        joblib.dump(difficulty_encoder, "difficulty_encoder.pkl")
        encoded_features['difficulty'] = 'difficulty_encoded'
    else:
        print("Warning: 'difficulty' column not found")
        df["difficulty_encoded"] = 0
    
    if 'confidence_level' in df.columns:
        confidence_encoder = LabelEncoder()
        df["confidence_encoded"] = confidence_encoder.fit_transform(df["confidence_level"].astype(str))
        joblib.dump(confidence_encoder, "confidence_encoder.pkl")
        encoded_features['confidence_level'] = 'confidence_encoded'
    else:
        print("Warning: 'confidence_level' column not found")
        df["confidence_encoded"] = 0
    
    # Define available features for the model
    available_features = []
    for feature in ["weightage", "time_alloted", "time_taken", "difficulty_encoded",
                    "subtopic_multiplier", "time_multiplier", "confidence_encoded", "confidence_multiplier"]:
        if feature in df.columns:
            available_features.append(feature)
        else:
            print(f"Warning: Feature '{feature}' not found in dataset")
    
    if not available_features:
        print("Error: No valid features found in dataset")
        return
    
    # Train and save model
    model, scaler = train_and_save_model(df, available_features)
    
    # Generate random questions
    random_questions = generate_random_questions(df)
    
    # Present questions to user
    user_results = present_questions_to_user(random_questions)
    
    # Calculate scores and ratings
    final_results, overall_rating = calculate_scores_and_ratings(
        user_results, model, scaler, available_features
    )
    
    # Final summary
    correct_count = final_results['is_correct'].sum() if 'is_correct' in final_results.columns else 0
    total_questions = len(final_results)
    correct_percentage = (correct_count / total_questions) * 100 if total_questions > 0 else 0
    
    print("\n🏁 ASSESSMENT COMPLETED!")
    print(f"Questions Answered: {total_questions}")
    print(f"Correct Answers: {correct_count}/{total_questions} ({correct_percentage:.1f}%)")
    print(f"Overall Star Rating: {overall_rating:.2f}/5.0")
    
    # Provide feedback based on star rating
    if overall_rating >= 4.5:
        print("\n Outstanding performance! You've demonstrated exceptional knowledge and skills.")
    elif overall_rating >= 4.0:
        print("\n Excellent work! You've shown a strong grasp of the material.")
    elif overall_rating >= 3.5:
        print("\n Very good performance! You have a solid understanding with some room for improvement.")
    elif overall_rating >= 3.0:
        print("\n Good job! You have a decent understanding of the material.")
    elif overall_rating >= 2.5:
        print("\n Fair performance. Consider reviewing some of the topics you struggled with.")
    elif overall_rating >= 2.0:
        print("\n You're on the right track, but need more practice to strengthen your understanding.")
    else:
        print("\n This material seems challenging for you. Consider reviewing the fundamentals and trying again.")

# Run the program if executed directly
if __name__ == "__main__":
    run_interactive_session()
