import pandas as pd
import numpy as np
import joblib
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.model_selection import train_test_split, KFold, cross_val_score
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.metrics import mean_squared_error, mean_absolute_error, r2_score
from sklearn.pipeline import Pipeline
from scipy.stats import pearsonr

# Function to calculate Concordance Correlation Coefficient (CCC)
def concordance_correlation_coefficient(y_true, y_pred):
    """
    Calculates Lin's concordance correlation coefficient.
    """
    # Calculate Pearson correlation
    cor = pearsonr(y_true, y_pred)[0]

    # Calculate means
    mean_true = np.mean(y_true)
    mean_pred = np.mean(y_pred)

    # Calculate variances
    var_true = np.var(y_true)
    var_pred = np.var(y_pred)

    # Calculate CCC
    sd_true = np.std(y_true)
    sd_pred = np.std(y_pred)

    # Formula for CCC
    numerator = 2 * cor * sd_true * sd_pred
    denominator = var_true + var_pred + (mean_true - mean_pred)**2 + 1e-8

    return numerator / denominator

# Function to evaluate and visualize model performance
def evaluate_model(model, X_train, X_test, y_train, y_test, model_name, feature_names, X_scaled):
    model.fit(X_train, y_train)
    y_pred = model.predict(X_test)

    # Calculate metrics
    rmse = np.sqrt(mean_squared_error(y_test, y_pred))
    mae = mean_absolute_error(y_test, y_pred)
    r2 = r2_score(y_test, y_pred)
    ccc = concordance_correlation_coefficient(y_test, y_pred)

    # Cross-validation
    kf = KFold(n_splits=5, shuffle=True, random_state=42)
    cv_scores = cross_val_score(model, X_scaled, y, cv=kf, scoring="r2")
    cv_r2_mean = np.mean(cv_scores)

    # Save model
    joblib.dump(model, f"{model_name.lower().replace(' ', '_')}_model.pkl")

    # Visualization
    plt.figure(figsize=(12, 10))

    # Plot 1: Predicted vs Actual
    plt.subplot(2, 1, 1)
    plt.scatter(y_test, y_pred, alpha=0.6, color="green", label="Predicted vs Actual")
    plt.plot([min(y), max(y)], [min(y), max(y)], color="red", linestyle="--", label="Ideal")
    plt.xlabel("Actual Star Rating")
    plt.ylabel("Predicted Star Rating")
    plt.title(f"{model_name}: Star Rating Prediction")
    plt.legend()
    plt.grid(True)

    # Plot 2: Residuals
    plt.subplot(2, 1, 2)
    residuals = y_test - y_pred
    plt.scatter(y_pred, residuals, alpha=0.6, color="blue")
    plt.axhline(y=0, color="red", linestyle="--")
    plt.xlabel("Predicted Values")
    plt.ylabel("Residuals")
    plt.title("Residual Plot (Actual - Predicted)")
    plt.grid(True)

    plt.tight_layout()
    plt.savefig(f"{model_name.lower().replace(' ', '_')}_prediction_quality.png")
    plt.close()

    # Feature importance (if available)
    feature_importance = {}
    if hasattr(model, 'feature_importances_'):
        for i, feature in enumerate(feature_names):
            feature_importance[feature] = model.feature_importances_[i]
    elif hasattr(model, 'coef_'):
        if model_name == "Polynomial Regression":
            # For polynomial regression, the coefficients need special handling
            poly_features = PolynomialFeatures(degree=2)
            feature_names_poly = poly_features.get_feature_names_out(feature_names)
            for i, feature in enumerate(feature_names_poly):
                if i < len(model.coef_):
                    feature_importance[feature] = abs(model.coef_[i])
        else:
            for i, feature in enumerate(feature_names):
                feature_importance[feature] = abs(model.coef_[i])

    return {
        'model': model,
        'rmse': rmse,
        'mae': mae,
        'r2': r2,
        'ccc': ccc,
        'cv_r2_mean': cv_r2_mean,
        'feature_importance': feature_importance
    }

# Function to calculate a comprehensive score for model selection
def calculate_comprehensive_score(model_metrics):
    """
    Calculate a comprehensive score based on multiple metrics

    Parameters:
    - model_metrics: Dictionary with all evaluation metrics

    Returns:
    - Comprehensive score (higher is better)
    """
    # For metrics where higher is better (r2, ccc, cv_r2_mean)
    r2_score = model_metrics['r2'] if model_metrics['r2'] > 0 else 0
    ccc_score = model_metrics['ccc']
    cv_score = model_metrics['cv_r2_mean'] if model_metrics['cv_r2_mean'] > 0 else 0

    # For metrics where lower is better (rmse, mae) - convert to a score where higher is better
    # Use inverse to make lower values result in higher scores
    rmse_score = 1 / (model_metrics['rmse'] + 0.1)  # Add small constant to avoid division by zero
    mae_score = 1 / (model_metrics['mae'] + 0.1)

    # Calculate weighted score - weights can be adjusted based on importance
    weights = {
        'r2': 0.25,
        'ccc': 0.25,
        'cv_r2_mean': 0.25,
        'rmse': 0.125,
        'mae': 0.125
    }

    comprehensive_score = (
        weights['r2'] * r2_score +
        weights['ccc'] * ccc_score +
        weights['cv_r2_mean'] * cv_score +
        weights['rmse'] * rmse_score +
        weights['mae'] * mae_score
    )

    return comprehensive_score

# 📌 Load and preprocess dataset
df = pd.read_csv("updated_js_questions.csv")

# Handle NaN values more carefully
numeric_cols = df.select_dtypes(include=[np.number]).columns
for col in numeric_cols:
    df[col].fillna(df[col].median(), inplace=True)

# Make sure we have the star_rating column
if 'star_rating' in df.columns:
    df.dropna(subset=["star_rating"], inplace=True)
else:
    print("Error: 'star_rating' column not found")
    exit()

# 🔄 Label Encoding for categorical columns
# Make sure the columns exist before encoding
if 'difficulty' in df.columns:
    difficulty_encoder = LabelEncoder()
    df["difficulty_encoded"] = difficulty_encoder.fit_transform(df["difficulty"].astype(str))
    joblib.dump(difficulty_encoder, "difficulty_encoder.pkl")
else:
    print("Warning: 'difficulty' column not found")
    df["difficulty_encoded"] = 0  # Default value

if 'confidence_level' in df.columns:
    confidence_encoder = LabelEncoder()
    df["confidence_encoded"] = confidence_encoder.fit_transform(df["confidence_level"].astype(str))
    joblib.dump(confidence_encoder, "confidence_encoder.pkl")
else:
    print("Warning: 'confidence_level' column not found")
    df["confidence_encoded"] = 0  # Default value

# ✅ Features and Target - Check if all features exist
available_features = []
for feature in ["weightage", "time_alloted", "time_taken", "difficulty_encoded",
                "subtopic_multiplier", "time_multiplier", "confidence_encoded", "confidence_multiplier"]:
    if feature in df.columns:
        available_features.append(feature)
    else:
        print(f"Warning: Feature '{feature}' not found in dataset")

if not available_features:
    print("Error: No valid features found")
    exit()

target = "star_rating"
X = df[available_features]
y = df[target]

# 📊 Standard Scaling
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
joblib.dump(scaler, "scaler.pkl")

# 🔄 Train/Test Split
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)

# 🧠 Define Models
models = {
    "Linear Regression": LinearRegression(),
    "Polynomial Regression": Pipeline([
        ('poly', PolynomialFeatures(degree=2)),
        ('linear', LinearRegression())
    ]),
    "Random Forest Regressor": RandomForestRegressor(
        n_estimators=100,
        max_depth=10,
        min_samples_split=5,
        min_samples_leaf=2,
        max_features="sqrt",
        random_state=42
    ),
    "Gradient Boosting Regressor": GradientBoostingRegressor(
        n_estimators=1200,
        learning_rate=0.03,
        max_depth=4,
        subsample=0.8,
        min_samples_split=10,
        min_samples_leaf=4,
        max_features="sqrt",
        random_state=42
    )
}

# 📊 Train and evaluate all models
results = {}
for model_name, model in models.items():
    print(f"\n🔍 Training {model_name}...")
    results[model_name] = evaluate_model(model, X_train, X_test, y_train, y_test, model_name, available_features, X_scaled)

# 📊 Calculate comprehensive scores for each model
comprehensive_scores = {}
for model_name, result in results.items():
    comprehensive_scores[model_name] = calculate_comprehensive_score(result)

# Add comprehensive score to the comparison
for model_name in results:
    results[model_name]['comprehensive_score'] = comprehensive_scores[model_name]

# 📊 Compare model performances
metrics = ['rmse', 'mae', 'r2', 'ccc', 'cv_r2_mean', 'comprehensive_score']
comparison_df = pd.DataFrame({
    model_name: {metric: results[model_name][metric] for metric in metrics}
    for model_name in models.keys()
}).T

# 📊 Visualization of model comparisons
plt.figure(figsize=(15, 10))

# R² comparison
plt.subplot(2, 2, 1)
comparison_df['r2'].plot(kind='bar', color='skyblue')
plt.title('R² Score Comparison')
plt.ylabel('R² Score')
plt.grid(axis='y')

# RMSE comparison
plt.subplot(2, 2, 2)
comparison_df['rmse'].plot(kind='bar', color='salmon')
plt.title('RMSE Comparison')
plt.ylabel('RMSE')
plt.grid(axis='y')

# MAE comparison
plt.subplot(2, 2, 3)
comparison_df['mae'].plot(kind='bar', color='lightgreen')
plt.title('MAE Comparison')
plt.ylabel('MAE')
plt.grid(axis='y')

# CCC comparison
plt.subplot(2, 2, 4)
comparison_df['ccc'].plot(kind='bar', color='orange')
plt.title('Concordance Correlation Coefficient (CCC) Comparison')
plt.ylabel('CCC')
plt.grid(axis='y')

plt.tight_layout()
plt.savefig("model_comparison_metrics.png")
plt.show()

# Comprehensive score visualization
plt.figure(figsize=(8, 6))
comparison_df['comprehensive_score'].plot(kind='bar', color='purple')
plt.title('Comprehensive Score Comparison')
plt.ylabel('Score')
plt.grid(axis='y')
plt.tight_layout()
plt.savefig("comprehensive_score_comparison.png")
plt.show()

# ✅ Print summary of all models
print("\n MODEL COMPARISON SUMMARY:")
print(comparison_df.round(4))

# Get the best model based on comprehensive score
best_model_name = comparison_df['comprehensive_score'].idxmax()
best_model = results[best_model_name]['model']

# Print comparison of all metrics for better analysis
print("\n DETAILED MODEL COMPARISON:")
model_ranks = {}
for metric in ['rmse', 'mae', 'r2', 'ccc', 'cv_r2_mean']:
    # For rmse and mae, lower is better, so we reverse the ranking
    if metric in ['rmse', 'mae']:
        ranked_models = comparison_df[metric].sort_values().index.tolist()
    else:
        ranked_models = comparison_df[metric].sort_values(ascending=False).index.tolist()

    model_ranks[metric] = {model: rank+1 for rank, model in enumerate(ranked_models)}

rank_df = pd.DataFrame(model_ranks)
print(rank_df)

# Individual feature performance analysis
print("\n Evaluating individual feature performance...")
feature_performance = {}

for feature in available_features:
    # Use only one feature at a time
    X_single = df[[feature]]
    X_single_scaled = scaler.fit_transform(X_single)

    # Train-test split
    X_train_single, X_test_single, y_train_single, y_test_single = train_test_split(
        X_single_scaled, y, test_size=0.2, random_state=42
    )

    # Use linear regression to evaluate the feature
    model = LinearRegression()
    model.fit(X_train_single, y_train_single)
    y_pred = model.predict(X_test_single)

    # Calculate metrics
    r2 = r2_score(y_test_single, y_pred)
    ccc = concordance_correlation_coefficient(y_test_single, y_pred)
    rmse = np.sqrt(mean_squared_error(y_test_single, y_pred))
    mae = mean_absolute_error(y_test_single, y_pred)

    feature_performance[feature] = {
        'R²': r2,
        'CCC': ccc,
        'RMSE': rmse,
        'MAE': mae
    }

# Create DataFrame for individual feature performance
individual_feature_df = pd.DataFrame(feature_performance).T
individual_feature_df.index.name = 'Feature'
individual_feature_df = individual_feature_df.reset_index()

# Sort by feature importance
individual_feature_df = individual_feature_df.sort_values('CCC', ascending=False)

print("\n INDIVIDUAL FEATURE PERFORMANCE:")
print(individual_feature_df.round(4))

# Feature importance comparison
print("\n FEATURE IMPORTANCE COMPARISON:")
feature_importance_comparison = {}

# Get feature importance from best model
best_model_importance = results[best_model_name]['feature_importance']
if best_model_importance:
    for feature in available_features:
        feature_importance_comparison[feature] = {
            'Model Importance': best_model_importance.get(feature, 0),
            'Individual CCC': individual_feature_df.loc[individual_feature_df['Feature'] == feature, 'CCC'].values[0],
        }

    # Calculate performance gap (indicates if feature performs better in combination)
    for feature in feature_importance_comparison:
        feature_importance_comparison[feature]['Performance Gap'] = (
            feature_importance_comparison[feature]['Model Importance'] -
            feature_importance_comparison[feature]['Individual CCC']
        )

    # Create DataFrame and display
    importance_df = pd.DataFrame(feature_importance_comparison).T
    importance_df.index.name = 'Feature'
    importance_df = importance_df.reset_index()
    importance_df = importance_df.sort_values('Model Importance', ascending=False)

    print(importance_df.round(4))

print(f"\n Feature importance analysis complete! Visualizations saved.")

# Print comprehensive analysis of best model
print(f"\n BEST MODEL (based on comprehensive evaluation): {best_model_name}")
print(f"Comprehensive Score: {results[best_model_name]['comprehensive_score']:.4f}")
print(f"CCC: {results[best_model_name]['ccc']:.4f}")
print(f"R² Score: {results[best_model_name]['r2']:.4f}")
print(f"RMSE: {results[best_model_name]['rmse']:.4f}")
print(f"MAE: {results[best_model_name]['mae']:.4f}")
print(f"Cross-validation R² Mean: {results[best_model_name]['cv_r2_mean']:.4f}")

# Print feature importance for the best model
print("\n FEATURE IMPORTANCE (BEST MODEL):")
feature_importance = results[best_model_name]['feature_importance']
if feature_importance:
    # Sort feature importance
    sorted_importance = sorted(feature_importance.items(), key=lambda x: x[1], reverse=True)
    for feature, importance in sorted_importance:
        print(f"{feature}: {importance:.4f}")
